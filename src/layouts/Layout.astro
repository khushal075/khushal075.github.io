---
import '../styles/global.css';
const {title,description='Architecture decisions, enterprise systems, and technical demonstrations by Khushal.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const navigation=[['About','/about/'],['Blog','/blog/'],['Decisions','/decisions/'],['Playground','/playground/'],['AI','/ai/']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><meta name="theme-color" content="#12695e"/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" title="Khushal / Architecture Notes" href="/rss.xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/></head><body><nav><a class="brand" href="/" aria-label="Khushal home">k<span>.</span></a><div class="navlinks">{navigation.map(([label,href])=><a href={href} aria-current={Astro.url.pathname.startsWith(href)?'page':undefined}>{label}</a>)}<a href="https://github.com/khushal075" target="_blank" rel="noopener">GitHub</a></div></nav><main><slot/></main><footer><span class="mono">Khushal / Strategy, grounded in execution.</span><div><a href="/subscribe/">Subscribe</a> &nbsp; · &nbsp; <a class="contact" href="https://github.com/khushal075">GitHub</a></div></footer></body></html>
