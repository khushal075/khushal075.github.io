---
import Layout from '../../layouts/Layout.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const tags=[...new Set(posts.flatMap(p=>p.data.tags))];
---
<Layout title="Architecture Notes / Khushal" description="Notes on enterprise architecture, system boundaries, and the tradeoffs behind working software."><header class="bloghero"><div class="eyebrow mono">The architecture notebook</div><h1>Decisions.<br>Tradeoffs.<br><em>Working evidence.</em></h1><p>Notes on how systems behave, where boundaries belong, and what a design asks an organization to commit to.</p><a class="caption mono" href="/rss.xml">Subscribe via RSS ↗</a></header><div class="filters" role="group" aria-label="Filter articles by topic"><button data-tag="all" aria-pressed="true">All notes</button>{tags.map(tag=><button data-tag={tag} aria-pressed="false">{tag}</button>)}</div><section class="postlist" aria-label="Articles">{posts.map(post=><a class="postitem" href={`/blog/${post.id}/`} data-tags={JSON.stringify(post.data.tags)}><div class="postmeta mono"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time> · {post.data.tags.join(' / ')}</div><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="projectlink mono">Read the note →</span></a>)}</section><script>document.querySelectorAll('[data-tag]').forEach(button=>button.addEventListener('click',()=>{const tag=button.getAttribute('data-tag');document.querySelectorAll('[data-tag]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-tags]').forEach(post=>{post.hidden=tag!=='all'&&!JSON.parse(post.dataset.tags||'[]').includes(tag)})}));</script></Layout>
