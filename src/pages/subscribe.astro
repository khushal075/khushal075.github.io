---
import Layout from '../layouts/Layout.astro';
const feedUrl=new URL('/rss.xml',Astro.site).href;
---
<Layout title="Subscribe / Khushal" description="Follow Khushal's architecture and applied AI articles in your RSS reader."><header class="bloghero articlehero"><div class="eyebrow mono">Follow the architecture notebook</div><h1>New ideas.<br>In your reader.</h1><p>Follow new articles about enterprise architecture, applied AI, and the decisions behind working systems.</p></header><section class="subscribe-panel" aria-labelledby="subscribe-title"><h2 id="subscribe-title">Subscribe with RSS</h2><p>RSS brings new articles into a feed reader you choose. This site does not collect your email address or send email newsletters.</p><ol><li>Copy the feed address below.</li><li>Open your RSS reader and choose its option to add a feed or follow a website.</li><li>Paste the address and confirm the subscription in your reader.</li></ol><label for="feed-url" class="mono">Feed address</label><div class="feed-controls"><input id="feed-url" type="url" value={feedUrl} readonly aria-describedby="feed-help"/><button id="copy-feed" class="btn primary" type="button">Copy feed URL</button></div><p id="copy-status" class="copy-status" role="status" aria-live="polite"></p><p id="feed-help" class="caption">The XML feed is meant for a reader application. Opening it directly may show XML text or download a file; that does not subscribe you.</p><div class="actions"><a class="btn" href="/rss.xml">Open XML feed</a><a class="btn" href="/blog/">Browse articles</a></div></section><script>
const button=document.querySelector<HTMLButtonElement>('#copy-feed');
const input=document.querySelector<HTMLInputElement>('#feed-url');
const status=document.querySelector<HTMLElement>('#copy-status');
button?.addEventListener('click',async()=>{if(!input||!status)return;try{await navigator.clipboard.writeText(input.value);status.textContent='Feed URL copied. Paste it into your RSS reader.';}catch{input.focus();input.select();status.textContent='Select and copy the feed address, then paste it into your RSS reader.';}});
</script><style>.subscribe-panel{max-width:700px;margin:0 auto 45px;padding:30px;border:1px solid var(--line);background:var(--panel);border-radius:12px}.subscribe-panel h2{margin:0 0 18px;font-size:26px}.subscribe-panel p,.subscribe-panel li{color:var(--muted);font-size:16px;line-height:1.8}.subscribe-panel ol{padding-left:24px;margin:24px 0}.subscribe-panel li{padding:5px 0}.subscribe-panel label{display:block;font-size:12px;margin:24px 0 12px}.feed-controls{display:flex;gap:10px}.feed-controls input{min-width:0;flex:1;width:100%;padding:13px;border:1px solid var(--line);border-radius:5px;background:var(--bg);color:var(--text);font-size:14px}.feed-controls button{white-space:nowrap}.copy-status{min-height:28px;font-size:14px!important;color:var(--green)!important}.subscribe-panel .caption{font-size:13px}@media(max-width:650px){.subscribe-panel{padding:22px}.feed-controls{flex-direction:column}.feed-controls button{justify-content:center}.subscribe-panel .actions{flex-wrap:wrap}}</style></Layout>
