---
import Layout from '../layouts/Layout.astro';
import home from '../components/home.html?raw';
---
<Layout title="Khushal / Enterprise Architecture & Applied AI" description="Enterprise architecture, applied AI, technical decisions, and hands-on systems engineering. Explore projects, architecture notes, and interactive demonstrations.">
<Fragment set:html={home} />
<script>
const routes:Record<string,string>={'#about':'/about/','#work':'/decisions/','#approach':'/decisions/decisions/#approach','#playground':'/playground/','#ai':'/ai/'};
const target=routes[window.location.hash];
if(target)window.location.replace(target);
</script>
</Layout>
